# Copy to .env and fill in. Never commit .env.
# All values are optional: without them CleanTrack runs with demo settings.

# Port for `npm start` (production server).
PORT=3000

# Where the SQLite database file is kept (default: server/data/cleantrack.db).
# DB_PATH=server/data/cleantrack.db

# Secret used to sign sign-in tokens. If empty, one is generated and stored in the database.
# CLEANTRACK_SECRET=change-me-to-a-long-random-string

# Email (SMTP). Without SMTP_HOST and MAIL_FROM, emails are logged as "not configured" and NOT sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="CleanTrack <no-reply@example.com>"
